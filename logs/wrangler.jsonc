{
  // Worker de journalisation des robots — voir worker.js pour le pourquoi.
  //
  // Deploiement :
  //   npx wrangler deploy --config logs/wrangler.jsonc
  //
  // Le schema s'applique avec :
  //   npx wrangler d1 execute pistes-athle-logs --remote --file logs/schema.sql
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pistes-athle-logs",
  "main": "worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],

  // Les deux hotes servis par GitHub Pages. www redirige vers l'apex, mais un
  // robot qui frappe www doit tout de meme etre compte.
  "routes": [
    { "pattern": "pistes-athle.com/*", "zone_name": "pistes-athle.com" },
    { "pattern": "www.pistes-athle.com/*", "zone_name": "pistes-athle.com" }
  ],

  // Matomo — voir `mesurer()` dans worker.js et docs/mesurer-le-trafic-des-ia.md.
  // Rien de secret ici : l'identifiant de site est deja public dans
  // assets/matomo.js, que sert chaque page.
  "vars": {
    "MATOMO_URL": "https://ronanchardonneau.matomo.cloud/",
    "MATOMO_SITE_ID": "149",
    // VERIFIE LE 25/08/2026 : Matomo ECARTE silencieusement les hits dont
    // l'user-agent n'est pas dans sa liste de chatbots. Un GPTBot envoye au
    // meme instant qu'un ChatGPT-User n'apparait nulle part dans ses
    // rapports, alors que les deux figurent bien en base D1.
    // Laisser "0" : les robots de corpus sont deja mesures par D1, qui est
    // de toute facon le bon outil pour eux (ordre de decouverte, couverture).
    // Le passer a "1" ne ferait que depenser une sous-requete par passage.
    "MATOMO_CORPUS": "0"
  },

  // Le secret du webhook GitHub n'est PAS ici : c'est un secret, il se pose
  // avec  npx wrangler secret put GITHUB_WEBHOOK_SECRET --config logs/wrangler.jsonc
  // Sans lui, la route /_hooks/github repond 503 et n'enregistre rien —
  // elle echoue fermee, jamais ouverte. Voir `hookGithub()` dans worker.js.


  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pistes-athle-logs",
      "database_id": "041cbf80-e411-487f-be2b-09195ed94c16"
    }
  ],

  // Le Worker voit chaque requete du site : echantillonner suffit largement,
  // et seules les erreurs de journalisation ecrivent dans les traces.
  "observability": { "enabled": true, "head_sampling_rate": 0.05 }
}
